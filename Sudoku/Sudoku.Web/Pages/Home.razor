@page "/"
@using Sudoku.Core.Models
@using Sudoku.Core.Generator
@using Sudoku.Core.Solver
@implements IDisposable

<div class="sudoku-container" tabindex="0" @onkeydown="HandleKeyDown" @ref="containerRef">
    <!-- Header -->
    <header class="app-header">
        <h1 class="app-title">Sudoku Solver &amp; Explainer</h1>
        <div class="app-subtitle">
            Intelligent logic deduction with delta-debugging minimization
        </div>
        <div>
            <span class="badge-feature">Step-by-Step Human Explanations • Exact Cover DLX • Non-3x3 Boards</span>
        </div>
    </header>

    <!-- Top Toolbar -->
    <div class="toolbar-card">
        <!-- Board Size Selector -->
        <div class="toolbar-group">
            <span class="toolbar-label">Size:</span>
            <select class="select-dark" value="@selectedSizeIndex" @onchange="OnSizeChanged">
                @for (int i = 0; i < sizeOptions.Count; i++)
                {
                    <option value="@i">@sizeOptions[i].Label</option>
                }
            </select>
        </div>

        <!-- Preset Selector -->
        <div class="toolbar-group">
            <span class="toolbar-label">Preset:</span>
            <select class="select-dark" @onchange="OnPresetSelected">
                @for (int i = 0; i < currentPresets.Count; i++)
                {
                    var p = currentPresets[i];
                    <option value="@i" selected="@(selectedPresetIndex == i)">@p.Title (@p.Difficulty)</option>
                }
            </select>
        </div>

        <!-- Difficulty / Generation Selector -->
        <div class="toolbar-group">
            <span class="toolbar-label">Difficulty:</span>
            <select class="select-dark" @bind="selectedDifficultyMode">
                <option value="Easy">Easy (0)</option>
                <option value="Medium">Medium (1.0..1.3)</option>
                <option value="Hard">Hard (1.4+ / 2)</option>
                <option value="Expert">Expert (>=2)</option>
                <option value="Custom">Custom Target...</option>
            </select>

            @if (selectedDifficultyMode == "Custom")
            {
                <input class="input-pattern" @bind="customDifficultyPattern" placeholder="e.g. 1.0.2, 1.*, >=2" title="Enter rating pattern (e.g. 1.0.2, 1.2.*, >=2, 1.0..1.3)" />
            }

            <button class="btn-tool" @onclick="GeneratePuzzle" disabled="@(isGenerating || isSolving)">
                @(isGenerating ? "Generating..." : "Generate Puzzle")
            </button>
        </div>

        <!-- Utilities -->
        <div class="toolbar-group">
            <button class="btn-tool" @onclick="ResetToInitial">Reset</button>
            <button class="btn-tool" @onclick="ClearAll">Clear Grid</button>
            <button class="btn-tool" @onclick="OpenImportExport">Import / Export</button>
        </div>
    </div>

    <!-- Active Generation / Solving Progress Cards -->
    @if (isGenerating && genProgress != null)
    {
        <div class="progress-card">
            <div class="progress-header">
                <span>⚡ @genProgress.Status</span>
                <button class="btn-cancel-small" @onclick="CancelGeneration">Cancel</button>
            </div>
            <div class="progress-track">
                <div class="progress-fill" style="width: @(Math.Clamp(genProgress.Attempt * 100 / Math.Max(1, genProgress.MaxAttempts), 5, 100))%;"></div>
            </div>
        </div>
    }

    @if (isSolving)
    {
        <div class="progress-card">
            <div class="progress-header">
                <span>🔍 @(solverProgress != null ? $"{solverProgress.CurrentAction} (Steps: {solverProgress.StepsCount}, Depth: {solverProgress.LookaheadDepth})" : "Analyzing puzzle logic...")</span>
                <button class="btn-cancel-small" @onclick="CancelSolving">Cancel</button>
            </div>
            <div class="progress-track">
                <div class="progress-fill" style="width: 100%; animation: pulseElimination 1s infinite alternate;"></div>
            </div>
        </div>
    }

    <!-- Main Workspace -->
    <div class="sudoku-workspace">
        <!-- Left Column: Board + Keypad -->
        <div class="board-column">
            <!-- Dynamic Sudoku Board -->
            <div class="sudoku-board-container board-size-@width">
                <div class="sudoku-board" style="grid-template-columns: repeat(@width, minmax(0, 1fr)); grid-template-rows: repeat(@width, minmax(0, 1fr));">
                    @for (int r = 0; r < width; r++)
                    {
                        for (int c = 0; c < width; c++)
                        {
                            int row = r;
                            int col = c;
                            int val = GetDisplayValue(row, col);
                            bool isGiven = initialGrid[row, col] != 0;
                            bool isSelected = selectedRow == row && selectedCol == col;
                            bool isMatchingNum = selectedVal > 0 && val == selectedVal;
                            bool isRelated = (selectedRow == row || selectedCol == col ||
                                              ((row / currentSizeY == selectedRow / currentSizeY) && (col / currentSizeX == selectedCol / currentSizeX))) && !isSelected;

                            // Walkthrough highlights
                            bool isStepTarget = activeStep != null && activeStep.Row == row && activeStep.Col == col;
                            bool isStepGroup = activeStep != null && IsInStepGroup(activeStep, row, col) && !isStepTarget;

                            string cellClasses = "sudoku-cell";
                            if ((col + 1) % currentSizeX == 0 && (col + 1) < width) cellClasses += " border-right-thick";
                            if ((row + 1) % currentSizeY == 0 && (row + 1) < width) cellClasses += " border-bottom-thick";

                            if (isSelected) cellClasses += " selected";
                            else if (isStepTarget) cellClasses += " step-affected-cell";
                            else if (isStepGroup) cellClasses += " step-affected-group";
                            else if (isMatchingNum) cellClasses += " matching-number";
                            else if (isRelated) cellClasses += " related-group";

                            if (isGiven) cellClasses += " clue-cell";
                            else if (currentSolution != null && val > 0) cellClasses += " solved-cell";
                            else if (val > 0) cellClasses += " user-cell";

                            <div class="@cellClasses" @onclick="() => SelectCell(row, col)">
                                @if (val > 0)
                                {
                                    @Board.FormatValue(val)
                                }
                                else if (showCandidates)
                                {
                                    <div class="candidates-grid" style="grid-template-columns: repeat(@currentSizeX, minmax(0, 1fr)); grid-template-rows: repeat(@currentSizeY, minmax(0, 1fr));">
                                        @for (int d = 1; d <= width; d++)
                                        {
                                            int digit = d;
                                            bool isCandidate = IsCellCandidate(row, col, digit);
                                            bool isEliminatedHere = isStepTarget && activeStep != null && activeStep.IsElimination && activeStep.Value == digit;

                                            string candClasses = "candidate-num";
                                            if (isEliminatedHere) candClasses += " eliminated-target";
                                            else if (isCandidate) candClasses += " active";

                                            <div class="@candClasses">
                                                @(isEliminatedHere || isCandidate ? Board.FormatValue(digit) : "")
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Numpad Keypad -->
            <div class="numpad-container">
                <div class="numpad-grid" style="grid-template-columns: repeat(@(width <= 9 ? width : (width <= 12 ? 6 : 8)), 1fr);">
                    @for (int d = 1; d <= width; d++)
                    {
                        int digit = d;
                        <button class="btn-numpad" @onclick="() => InputDigit(digit)">@Board.FormatValue(digit)</button>
                    }
                </div>
                <div class="numpad-actions">
                    <button class="btn-action-pill" @onclick="ClearSelectedCell">
                        <span>⌫</span> Erase
                    </button>
                    <button class="btn-action-pill @(isPencilMode ? "active" : "")" @onclick="() => isPencilMode = !isPencilMode">
                        <span>✏️</span> Pencil @(isPencilMode ? "ON" : "OFF")
                    </button>
                    <button class="btn-action-pill @(showCandidates ? "active" : "")" @onclick="ToggleCandidates">
                        <span>👁️</span> Candidates @(showCandidates ? "ON" : "OFF")
                    </button>
                </div>
            </div>
        </div>

        <!-- Right Column: Explainer & Controls -->
        <div class="sidebar-column">
            <!-- Action Buttons Card -->
            <div class="actions-card">
                <button class="btn-explain" @onclick="ExplainSolution" disabled="@(isSolving || isGenerating)">
                    <span>✨</span> @(isSolving ? "Analyzing..." : "Explain Solution")
                </button>
                <button class="btn-fast-solve" @onclick="FastSolve" disabled="@(isSolving || isGenerating)">
                    <span>⚡</span> Fast Solve (DLX)
                </button>
            </div>

            <!-- Status Banner -->
            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <div class="stats-banner">
                    <div class="stat-item">
                        <span class="stat-label">Status</span>
                        <span class="stat-value" style="font-size: 0.95rem;">@statusMessage</span>
                    </div>
                    @if (currentSolution != null && currentSolution.IsSuccess)
                    {
                        <div class="stat-item">
                            <span class="stat-label">Rating</span>
                            <span class="stat-badge @GetDifficultyBadgeClass(currentSolution)">
                                Lookahead: @currentSolution.MaxLookaheadUsed (Score: @currentSolution.Score)
                            </span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Steps</span>
                            <span class="stat-value">@currentSolution.Steps.Count</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Time</span>
                            <span class="stat-value">@($"{currentSolution.Elapsed.TotalMilliseconds:F1} ms")</span>
                        </div>
                    }
                </div>
            }

            <!-- Explanation Walkthrough Card -->
            @if (currentSolution != null && currentSolution.Steps.Count > 0)
            {
                <div class="explainer-card">
                    <div class="explainer-card-header">
                        <h2 class="explainer-title">
                            <span>🔍</span> Solution Walkthrough
                        </h2>
                        <span class="toolbar-label">
                            Step @(currentStepIndex + 1) of @currentSolution.Steps.Count
                        </span>
                    </div>

                    <!-- Playback Controls -->
                    <div class="playback-controls">
                        <button class="btn-playback" @onclick="FirstStep" disabled="@(currentStepIndex <= 0)" title="First Step">⏮ First</button>
                        <button class="btn-playback" @onclick="PrevStep" disabled="@(currentStepIndex <= 0)" title="Previous Step">◀ Prev</button>
                        <button class="btn-playback btn-playback-play" @onclick="TogglePlay">
                            @(isPlaying ? "⏸ Pause" : "▶ Play")
                        </button>
                        <button class="btn-playback" @onclick="NextStep" disabled="@(currentStepIndex >= currentSolution.Steps.Count - 1)" title="Next Step">Next ▶</button>
                        <button class="btn-playback" @onclick="LastStep" disabled="@(currentStepIndex >= currentSolution.Steps.Count - 1)" title="Last Step">Last ⏭</button>
                        <select class="speed-select" @bind="playbackSpeedMs">
                            <option value="300">Fast (0.3s)</option>
                            <option value="600">Medium (0.6s)</option>
                            <option value="1000">Normal (1.0s)</option>
                            <option value="1800">Slow (1.8s)</option>
                        </select>
                    </div>

                    <!-- Active Step Highlight Card -->
                    @if (activeStep != null)
                    {
                        <div class="active-step-card">
                            <div class="step-meta">
                                <span class="step-number-tag">Step #@activeStep.StepNumber</span>
                                <span class="step-type-tag">@(activeStep.IsElimination ? "Elimination" : "Placement")</span>
                                <span class="toolbar-label">@activeStep.GroupDescription</span>
                            </div>
                            <p class="step-explanation-text">
                                @activeStep.Explanation
                            </p>

                            @if (activeStep.ProofChain != null && activeStep.ProofChain.Count > 0)
                            {
                                <div class="proof-chain-container">
                                    <div class="proof-chain-title">Contradiction Chain (@activeStep.ProofChain.Count steps):</div>
                                    @foreach (var chainStep in activeStep.ProofChain)
                                    {
                                        <div class="proof-chain-step">@chainStep</div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Scrollable Steps List -->
                    <div class="steps-list-container">
                        @for (int i = 0; i < currentSolution.Steps.Count; i++)
                        {
                            int idx = i;
                            var s = currentSolution.Steps[idx];
                            bool isCurrent = idx == currentStepIndex;
                            <div class="step-row-item @(isCurrent ? "current" : "")" @onclick="() => GoToStep(idx)">
                                <span class="step-number-tag" style="font-size: 0.7rem;">#@s.StepNumber</span>
                                <span class="step-row-text">@s.Explanation</span>
                                <span class="step-type-tag" style="font-size: 0.65rem;">@(s.IsElimination ? "Elim" : "Place")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Import / Export Modal -->
    @if (showImportModal)
    {
        <div class="modal-overlay" @onclick="() => showImportModal = false">
            <div class="modal-dialog-box" @onclick:stopPropagation="true">
                <h3 class="modal-title">Import / Export Puzzle</h3>
                <p style="font-size: 0.85rem; color: #94a3b8; margin: 0;">
                    Supports compact character strings or multi-line ASCII grids with |, +, - dividers.
                </p>
                <textarea class="modal-textarea" @bind="importText" style="height: 160px;"></textarea>
                <div class="modal-actions">
                    <button class="btn-tool" @onclick="ExportCompact">Export Compact</button>
                    <button class="btn-tool" @onclick="ExportAscii">Export ASCII Grid</button>
                    <button class="btn-tool" @onclick="ImportPuzzle">Load Puzzle</button>
                    <button class="btn-tool" @onclick="() => showImportModal = false">Close</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private record SizeOption(string Label, int SizeX, int SizeY)
    {
        public int Width => SizeX * SizeY;
    }

    private readonly List<SizeOption> sizeOptions = new()
    {
        new("2x3 (6x6)", 3, 2),
        new("3x3 (9x9)", 3, 3),
        new("3x4 (12x12)", 4, 3),
        new("4x4 (16x16)", 4, 4)
    };

    private int selectedSizeIndex = 1; // Default to 3x3 (9x9)
    private int currentSizeX = 3;
    private int currentSizeY = 3;
    private int width = 9;

    private ElementReference containerRef;
    private int[,] initialGrid = new int[9, 9];
    private int[,] currentGrid = new int[9, 9];
    private bool[,,] candidateMarks = new bool[9, 9, 9];

    // Playback simulated state
    private int[,] playbackGrid = new int[9, 9];
    private bool[,,] playbackCandidates = new bool[9, 9, 9];

    private int selectedRow = -1;
    private int selectedCol = -1;
    private int selectedVal => (selectedRow >= 0 && selectedCol >= 0) ? GetDisplayValue(selectedRow, selectedCol) : 0;

    private bool showCandidates = false;
    private bool isPencilMode = false;
    private int selectedPresetIndex = 0;
    private IReadOnlyList<PresetPuzzle> currentPresets = Array.Empty<PresetPuzzle>();

    private string selectedDifficultyMode = "Medium";
    private string customDifficultyPattern = "";

    private bool isSolving = false;
    private bool isGenerating = false;
    private GenerationProgress? genProgress;
    private SolverProgress? solverProgress;
    private CancellationTokenSource? genCts;
    private CancellationTokenSource? solveCts;

    private string statusMessage = "Select a puzzle or click 'Explain Solution' to begin.";

    private SudokuSolution? currentSolution;
    private int currentStepIndex = -1;
    private DeductionStep? activeStep => (currentSolution != null && currentStepIndex >= 0 && currentStepIndex < currentSolution.Steps.Count)
        ? currentSolution.Steps[currentStepIndex]
        : null;

    private bool isPlaying = false;
    private int playbackSpeedMs = 600;
    private CancellationTokenSource? playCts;

    private bool showImportModal = false;
    private string importText = "";

    protected override void OnInitialized()
    {
        UpdatePresetsForSize();
        if (currentPresets.Count > 0)
        {
            LoadPreset(currentPresets[0]);
        }
    }

    private void UpdatePresetsForSize()
    {
        currentPresets = PresetPuzzle.GetPresetsForSize(currentSizeX, currentSizeY);
        selectedPresetIndex = 0;
    }

    private void OnSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idx) && idx >= 0 && idx < sizeOptions.Count)
        {
            selectedSizeIndex = idx;
            var opt = sizeOptions[idx];
            currentSizeX = opt.SizeX;
            currentSizeY = opt.SizeY;
            width = opt.Width;

            StopPlay();
            initialGrid = new int[width, width];
            currentGrid = new int[width, width];
            candidateMarks = new bool[width, width, width];
            playbackGrid = new int[width, width];
            playbackCandidates = new bool[width, width, width];

            currentSolution = null;
            currentStepIndex = -1;
            selectedRow = -1;
            selectedCol = -1;

            UpdatePresetsForSize();
            if (currentPresets.Count > 0 && !string.IsNullOrWhiteSpace(currentPresets[0].Clues) && currentPresets[0].Clues.Any(c => c != '.' && c != '0'))
            {
                LoadPreset(currentPresets[0]);
            }
            else
            {
                statusMessage = $"Switched board size to {opt.Label}.";
            }
        }
    }

    private void OnPresetSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int index) && index >= 0 && index < currentPresets.Count)
        {
            selectedPresetIndex = index;
            LoadPreset(currentPresets[index]);
        }
    }

    private void LoadPreset(PresetPuzzle preset)
    {
        StopPlay();
        var board = Board.Parse(preset.Clues, currentSizeX, currentSizeY);
        initialGrid = board.Cells;
        currentGrid = (int[,])initialGrid.Clone();
        candidateMarks = new bool[width, width, width];
        playbackGrid = (int[,])initialGrid.Clone();
        playbackCandidates = new bool[width, width, width];

        currentSolution = null;
        currentStepIndex = -1;
        statusMessage = $"Loaded preset: {preset.Title} ({preset.Difficulty})";
    }

    private DifficultyCriteria GetSelectedCriteria()
    {
        return selectedDifficultyMode switch
        {
            "Easy" => DifficultyCriteria.Easy,
            "Medium" => DifficultyCriteria.Medium,
            "Hard" => DifficultyCriteria.Hard,
            "Expert" => DifficultyCriteria.Expert,
            "Custom" => DifficultyCriteria.Custom(customDifficultyPattern),
            _ => DifficultyCriteria.Medium
        };
    }

    private async Task GeneratePuzzle()
    {
        StopPlay();
        isGenerating = true;
        genCts = new CancellationTokenSource();
        var criteria = GetSelectedCriteria();
        string targetLabel = selectedDifficultyMode == "Custom" ? customDifficultyPattern : selectedDifficultyMode;
        statusMessage = $"Generating {targetLabel} puzzle with unique solution...";
        StateHasChanged();
        await Task.Yield();

        try
        {
            var gen = new SudokuGenerator(currentSizeX, currentSizeY);
            var progress = new Progress<GenerationProgress>(p =>
            {
                genProgress = p;
                StateHasChanged();
            });

            var board = await gen.GenerateAsync(criteria, progress, genCts.Token);
            initialGrid = board.Cells;
            currentGrid = (int[,])initialGrid.Clone();
            candidateMarks = new bool[width, width, width];
            playbackGrid = (int[,])initialGrid.Clone();
            playbackCandidates = new bool[width, width, width];

            currentSolution = null;
            currentStepIndex = -1;
            statusMessage = $"Generated puzzle with difficulty rating: {board.DifficultyRating}";
        }
        catch (OperationCanceledException)
        {
            statusMessage = "Puzzle generation cancelled.";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error generating puzzle: {ex.Message}";
        }
        finally
        {
            isGenerating = false;
            genProgress = null;
            genCts?.Dispose();
            genCts = null;
            StateHasChanged();
        }
    }

    private void CancelGeneration()
    {
        genCts?.Cancel();
    }

    private void CancelSolving()
    {
        solveCts?.Cancel();
    }

    private void ResetToInitial()
    {
        StopPlay();
        currentGrid = (int[,])initialGrid.Clone();
        candidateMarks = new bool[width, width, width];
        playbackGrid = (int[,])initialGrid.Clone();
        playbackCandidates = new bool[width, width, width];

        currentSolution = null;
        currentStepIndex = -1;
        statusMessage = "Reset to initial clues.";
    }

    private void ClearAll()
    {
        StopPlay();
        initialGrid = new int[width, width];
        currentGrid = new int[width, width];
        candidateMarks = new bool[width, width, width];
        playbackGrid = new int[width, width];
        playbackCandidates = new bool[width, width, width];

        currentSolution = null;
        currentStepIndex = -1;
        statusMessage = "Grid cleared. Enter custom clues or generate a puzzle.";
    }

    private void SelectCell(int r, int c)
    {
        selectedRow = r;
        selectedCol = c;
    }

    private void InputDigit(int digit)
    {
        if (selectedRow < 0 || selectedCol < 0) return;
        if (digit < 1 || digit > width) return;
        if (initialGrid[selectedRow, selectedCol] != 0) return; // Clue cells are immutable

        if (isPencilMode)
        {
            candidateMarks[selectedRow, selectedCol, digit - 1] = !candidateMarks[selectedRow, selectedCol, digit - 1];
        }
        else
        {
            currentGrid[selectedRow, selectedCol] = (currentGrid[selectedRow, selectedCol] == digit) ? 0 : digit;
            if (currentSolution != null)
            {
                currentSolution = null;
                currentStepIndex = -1;
            }
        }
    }

    private void ClearSelectedCell()
    {
        if (selectedRow < 0 || selectedCol < 0) return;
        if (initialGrid[selectedRow, selectedCol] != 0) return;

        currentGrid[selectedRow, selectedCol] = 0;
        for (int d = 0; d < width; d++) candidateMarks[selectedRow, selectedCol, d] = false;

        if (currentSolution != null)
        {
            currentSolution = null;
            currentStepIndex = -1;
        }
    }

    private void ToggleCandidates()
    {
        showCandidates = !showCandidates;
        if (showCandidates)
        {
            PopulateCandidatesFromLogicalPossibilities();
        }
    }

    private void PopulateCandidatesFromLogicalPossibilities()
    {
        var board = new Board(currentSizeX, currentSizeY);
        for (int r = 0; r < width; r++)
            for (int c = 0; c < width; c++)
                if (currentGrid[r, c] != 0) board.Set(r, c, currentGrid[r, c]);

        for (int r = 0; r < width; r++)
        {
            for (int c = 0; c < width; c++)
            {
                if (currentGrid[r, c] == 0)
                {
                    var cand = board.GetCandidates(r, c);
                    for (int d = 1; d <= width; d++)
                    {
                        candidateMarks[r, c, d - 1] = cand.Contains(d);
                    }
                }
            }
        }
    }

    private async Task ExplainSolution()
    {
        StopPlay();
        isSolving = true;
        solveCts = new CancellationTokenSource();
        statusMessage = "Analyzing puzzle and generating minimized explanation...";
        StateHasChanged();
        await Task.Yield();

        try
        {
            var board = new Board(currentSizeX, currentSizeY) { MaxLookahead = 2 };
            for (int r = 0; r < width; r++)
            {
                for (int c = 0; c < width; c++)
                {
                    if (currentGrid[r, c] != 0) board.Set(r, c, currentGrid[r, c]);
                }
            }

            var progress = new Progress<SolverProgress>(p =>
            {
                solverProgress = p;
                StateHasChanged();
            });

            var solution = await board.SolveWithRatingAsync(progress, solveCts.Token);
            currentSolution = solution;

            if (solution.IsSuccess)
            {
                currentStepIndex = 0;
                UpdatePlaybackSimulation();
                statusMessage = $"Puzzle solved logically in {solution.Steps.Count} steps! (Lookahead: {solution.MaxLookaheadUsed})";
            }
            else if (solution.State == SolveState.MultipleSolutions)
            {
                statusMessage = "Puzzle has multiple possible solutions or requires deeper lookahead.";
            }
            else
            {
                statusMessage = "Puzzle is unsolvable (contains contradictory clues).";
            }
        }
        catch (OperationCanceledException)
        {
            statusMessage = "Explanation generation cancelled.";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSolving = false;
            solverProgress = null;
            solveCts?.Dispose();
            solveCts = null;
            StateHasChanged();
        }
    }

    private void FastSolve()
    {
        StopPlay();
        var board = new Board(currentSizeX, currentSizeY);
        for (int r = 0; r < width; r++)
        {
            for (int c = 0; c < width; c++)
            {
                if (currentGrid[r, c] != 0) board.Set(r, c, currentGrid[r, c]);
            }
        }

        var solution = board.SolveFast();
        if (solution.IsSuccess)
        {
            currentGrid = (int[,])solution.SolvedGrid.Clone();
            currentSolution = null;
            currentStepIndex = -1;
            statusMessage = $"Solved instantly via Knuth's Dancing Links (DLX) in {solution.Elapsed.TotalMilliseconds:F2} ms.";
        }
        else if (solution.State == SolveState.MultipleSolutions)
        {
            statusMessage = "DLX found multiple solutions for this puzzle.";
        }
        else
        {
            statusMessage = "DLX determined this puzzle is unsolvable.";
        }
    }

    private void UpdatePlaybackSimulation()
    {
        if (currentSolution == null || currentStepIndex < 0 || currentSolution.Steps.Count == 0)
        {
            return;
        }

        // Force candidates mode so user can inspect eliminations
        showCandidates = true;

        // Reset to initial clues
        playbackGrid = (int[,])initialGrid.Clone();
        playbackCandidates = new bool[width, width, width];

        var tempBoard = new Board(currentSizeX, currentSizeY);
        for (int r = 0; r < width; r++)
            for (int c = 0; c < width; c++)
                if (initialGrid[r, c] != 0)
                    tempBoard.Set(r, c, initialGrid[r, c]);

        for (int r = 0; r < width; r++)
        {
            for (int c = 0; c < width; c++)
            {
                if (initialGrid[r, c] == 0)
                {
                    for (int d = 1; d <= width; d++)
                    {
                        playbackCandidates[r, c, d - 1] = tempBoard.CheckPossible(r, c, d);
                    }
                }
            }
        }

        // Apply steps up to currentStepIndex
        for (int i = 0; i <= currentStepIndex; i++)
        {
            var step = currentSolution.Steps[i];
            if (step.IsPlacement)
            {
                playbackGrid[step.Row, step.Col] = step.Value;
                for (int d = 1; d <= width; d++)
                    playbackCandidates[step.Row, step.Col, d - 1] = false;

                // Eliminate placed digit from peer rows, cols, and blocks
                for (int k = 0; k < width; k++)
                {
                    playbackCandidates[step.Row, k, step.Value - 1] = false;
                    playbackCandidates[k, step.Col, step.Value - 1] = false;
                }
                int br = (step.Row / currentSizeY) * currentSizeY;
                int bc = (step.Col / currentSizeX) * currentSizeX;
                for (int rr = br; rr < br + currentSizeY; rr++)
                {
                    for (int cc = bc; cc < bc + currentSizeX; cc++)
                    {
                        playbackCandidates[rr, cc, step.Value - 1] = false;
                    }
                }
            }
            else if (step.IsElimination)
            {
                // CRUCIAL FIX: Eliminations only prune candidates, never set cell values!
                playbackCandidates[step.Row, step.Col, step.Value - 1] = false;
            }
        }
    }

    private int GetDisplayValue(int r, int c)
    {
        if (currentSolution != null && currentStepIndex >= 0 && currentSolution.Steps.Count > 0)
        {
            return playbackGrid[r, c];
        }
        return currentGrid[r, c];
    }

    private bool IsCellCandidate(int r, int c, int d)
    {
        if (currentSolution != null && currentStepIndex >= 0 && currentSolution.Steps.Count > 0)
        {
            return playbackCandidates[r, c, d - 1];
        }
        return candidateMarks[r, c, d - 1];
    }

    private bool IsInStepGroup(DeductionStep step, int r, int c)
    {
        return step.Type switch
        {
            DeductionType.HiddenSingleRow => r == step.Row,
            DeductionType.HiddenSingleColumn => c == step.Col,
            DeductionType.HiddenSingleBox => (r / currentSizeY == step.Row / currentSizeY) && (c / currentSizeX == step.Col / currentSizeX),
            _ => false
        };
    }

    private void GoToStep(int index)
    {
        if (currentSolution == null) return;
        currentStepIndex = Math.Clamp(index, 0, currentSolution.Steps.Count - 1);
        UpdatePlaybackSimulation();

        if (activeStep != null)
        {
            selectedRow = activeStep.Row;
            selectedCol = activeStep.Col;
        }
    }

    private void NextStep()
    {
        if (currentSolution == null || currentStepIndex >= currentSolution.Steps.Count - 1) return;
        GoToStep(currentStepIndex + 1);
    }

    private void PrevStep()
    {
        if (currentSolution == null || currentStepIndex <= 0) return;
        GoToStep(currentStepIndex - 1);
    }

    private void FirstStep() => GoToStep(0);
    private void LastStep()
    {
        if (currentSolution != null) GoToStep(currentSolution.Steps.Count - 1);
    }

    private void TogglePlay()
    {
        if (isPlaying)
        {
            StopPlay();
        }
        else
        {
            StartPlay();
        }
    }

    private void StartPlay()
    {
        if (currentSolution == null || currentSolution.Steps.Count == 0) return;
        isPlaying = true;
        playCts = new CancellationTokenSource();
        var token = playCts.Token;

        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested && isPlaying)
            {
                await Task.Delay(playbackSpeedMs, token);
                await InvokeAsync(() =>
                {
                    if (currentStepIndex < currentSolution.Steps.Count - 1)
                    {
                        NextStep();
                        StateHasChanged();
                    }
                    else
                    {
                        StopPlay();
                        StateHasChanged();
                    }
                });
            }
        }, token);
    }

    private void StopPlay()
    {
        isPlaying = false;
        playCts?.Cancel();
        playCts = null;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        string key = e.Key.ToUpperInvariant();
        switch (key)
        {
            case "ARROWUP":
                if (selectedRow > 0) selectedRow--;
                break;
            case "ARROWDOWN":
                if (selectedRow < width - 1) selectedRow++;
                break;
            case "ARROWLEFT":
                if (selectedCol > 0) selectedCol--;
                break;
            case "ARROWRIGHT":
                if (selectedCol < width - 1) selectedCol++;
                break;
            case "1" or "2" or "3" or "4" or "5" or "6" or "7" or "8" or "9":
                int num = int.Parse(key);
                if (num <= width) InputDigit(num);
                break;
            case "A" or "B" or "D" or "E" or "F" or "G":
                int hexVal = key[0] - 'A' + 10;
                if (hexVal <= width) InputDigit(hexVal);
                break;
            case "C":
                if (width > 9 && selectedRow >= 0 && selectedCol >= 0)
                {
                    InputDigit(12);
                }
                else
                {
                    ToggleCandidates();
                }
                break;
            case "BACKSPACE" or "DELETE" or "0":
                ClearSelectedCell();
                break;
            case "P":
                isPencilMode = !isPencilMode;
                break;
            case " ":
                if (currentSolution != null) NextStep();
                break;
        }
    }

    private void OpenImportExport()
    {
        showImportModal = true;
        ExportCompact();
    }

    private void ExportCompact()
    {
        var board = new Board(currentSizeX, currentSizeY);
        for (int r = 0; r < width; r++)
            for (int c = 0; c < width; c++)
                if (currentGrid[r, c] != 0) board.Set(r, c, currentGrid[r, c]);
        importText = board.ToSimpleString();
    }

    private void ExportAscii()
    {
        var board = new Board(currentSizeX, currentSizeY);
        for (int r = 0; r < width; r++)
            for (int c = 0; c < width; c++)
                if (currentGrid[r, c] != 0) board.Set(r, c, currentGrid[r, c]);
        importText = board.ToAsciiString();
    }

    private void ImportPuzzle()
    {
        if (!string.IsNullOrWhiteSpace(importText))
        {
            // Auto-detect size if string matches 36, 81, 144, 256
            string cleaned = importText.Trim();
            int nonDividerCount = cleaned.Count(ch => !char.IsWhiteSpace(ch) && ch != '|' && ch != '+' && ch != '-' && ch != '=');
            if (nonDividerCount == 36 && width != 6)
            {
                OnSizeChanged(new ChangeEventArgs { Value = "0" });
            }
            else if (nonDividerCount == 81 && width != 9)
            {
                OnSizeChanged(new ChangeEventArgs { Value = "1" });
            }
            else if (nonDividerCount == 144 && width != 12)
            {
                OnSizeChanged(new ChangeEventArgs { Value = "2" });
            }
            else if (nonDividerCount == 256 && width != 16)
            {
                OnSizeChanged(new ChangeEventArgs { Value = "3" });
            }

            var board = Board.Parse(importText, currentSizeX, currentSizeY);
            initialGrid = board.Cells;
            currentGrid = (int[,])initialGrid.Clone();
            candidateMarks = new bool[width, width, width];
            playbackGrid = (int[,])initialGrid.Clone();
            playbackCandidates = new bool[width, width, width];

            currentSolution = null;
            currentStepIndex = -1;
            statusMessage = "Puzzle imported successfully.";
            showImportModal = false;
        }
    }

    private string GetDifficultyBadgeClass(SudokuSolution sol)
    {
        return sol.MaxLookaheadUsed switch
        {
            0 => "badge-easy",
            1 => "badge-medium",
            _ => "badge-hard"
        };
    }

    public void Dispose()
    {
        StopPlay();
        genCts?.Dispose();
        solveCts?.Dispose();
    }
}
